        "def clusterizacion(Xi):\n",
        "\n",
        " Xc = np.random.choice(Xi,size = 5)\n",
        " Xc = np.sort(Xc)\n",
        " nc=np.zeros((len(Xi),1))\n",
        "\n",
        " for k in range(len(Xi)):\n",
        "  d=np.abs(Xc-Xi[k])\n",
        "  nc[k]=np.argmin(d)\n",
        "  nc2=np.int32(nc[k])\n",
        "  Xc[nc2,]=(Xc[nc2]+Xi[k])/2\n",
        "\n",
        " return Xc,nc"
      ],
